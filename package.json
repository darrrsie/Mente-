{
  "name": "mente-e-movimento",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --charset=utf8 --outfile=src/app.bundle.js",
    "predev": "npm run build",
    "dev": "node scripts/serve.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "network:check": "powershell -NoProfile -File scripts/network.ps1",
    "network:configure": "powershell -NoProfile -File scripts/network.ps1 -Action Configure"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
