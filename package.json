{
  "name": "mente-e-movimento",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "apk": "node scripts/build-apk.mjs",
    "pretest": "node scripts/build-mobile.mjs",
    "test": "node --test tests/*.test.mjs",
