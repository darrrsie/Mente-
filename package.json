    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
