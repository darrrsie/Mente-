# Public web game. Permit only the page and browser assets; block project files.
Options -Indexes
RewriteEngine On
RewriteRule ^$ index.html [END]
RewriteRule ^(?:index\.html|src/(?:app(?:\.bundle)?\.js|games\.js|tutorials\.js|state\.js|styles\.css)|assets/icon-512\.png)$ - [END]
RewriteRule ^ - [F]
