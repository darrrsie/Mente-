# Public web game. Permit only the page and browser assets; block project files.
Options -Indexes
RewriteEngine On
RewriteRule ^$ index.html [END]
RewriteRule ^(?:index\.html|src/(?:app(?:\.bundle)?\.js|games\.js|tutorials\.js|state\.js|styles\.css|themes\.css)|assets/(?:icon-512\.png|map-garden\.svg))$ - [END]
RewriteRule ^ - [F]
